# Local editing uses browser storage; no AI services or models are required.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_COMMERCIAL_MODE=true
NEXT_TELEMETRY_DISABLED=1
# Optional account/cloud services. Set a unique secret before deployment.
DATABASE_URL=postgresql://editing_desk:local_editing_desk@localhost:5433/editing_desk
BETTER_AUTH_SECRET=replace-with-a-random-secret
# Optional online sound search; leave empty for local editing.
FREESOUND_API_KEY=
FREESOUND_CLIENT_ID=
